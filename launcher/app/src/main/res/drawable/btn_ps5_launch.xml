<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="45" android:startColor="#FF0070D1" android:endColor="#FF06B6D4" />
            <stroke android:width="2.5dp" android:color="#FFFFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="45" android:startColor="#CC0070D1" android:endColor="#9906B6D4" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>
