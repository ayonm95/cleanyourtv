<?xml version="1.0" encoding="utf-8"?>
<!-- Official PlayStation 5 Squircle Banner for CleanYourTV -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF0070D1" android:endColor="#FF002875" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:width="84dp" android:height="84dp" android:gravity="center"
        android:drawable="@drawable/ic_ps5" />
</layer-list>
